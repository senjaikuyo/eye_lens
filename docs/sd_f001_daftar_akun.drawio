  <diagram name="Mermaid-Code" id="mermaid_code_page">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="mermaid_text_box" parent="1" vertex="1" value="sequenceDiagram&#10;    autonumber&#10;    actor Pengguna as Pengguna&#10;    participant View as registerForm:RegisterView&#10;    participant Ctrl as ctrlUsers:UsersController&#10;    participant DB as db:DataBase&#10;&#10;    %% Alur Utama (Navigasi)&#10;    Pengguna-&gt;&gt;View: directRegister()&#10;    activate View&#10;    View--&gt;&gt;Pengguna: displayRegisterForm()&#10;    deactivate View&#10;&#10;    %% Alur Pengisian &amp; Submit&#10;    Pengguna-&gt;&gt;View: submitData(email, password, confirmPassword)&#10;    activate View&#10;    View-&gt;&gt;Ctrl: register(email, password, confirmPassword)&#10;    activate Ctrl&#10;&#10;    %% Validasi di Controller&#10;    Ctrl-&gt;&gt;Ctrl: validateFormatData()&#10;&#10;    %% Percabangan (Alt Fragment)&#10;    alt Data Valid (Skenario Utama)&#10;        Ctrl-&gt;&gt;DB: storeUser(email, hashPassword, role=&quot;user&quot;, status=true)&#10;        activate DB&#10;        DB--&gt;&gt;Ctrl: returnSuccess&#10;        deactivate DB&#10;        Ctrl--&gt;&gt;View: registerSuccess(message)&#10;        View--&gt;&gt;Pengguna: directLoginPage()&#10;    else Format Email Salah / Kolom Kosong&#10;        Ctrl--&gt;&gt;View: showError(&quot;Format email tidak valid / kolom kosong&quot;)&#10;        View--&gt;&gt;Pengguna: displayErrorMessage()&#10;    else Password dan Confirm Password Tidak Cocok&#10;        Ctrl--&gt;&gt;View: showError(&quot;Confirm password tidak cocok&quot;)&#10;        View--&gt;&gt;Pengguna: displayMismatchMessage()&#10;    end&#10;    deactivate Ctrl&#10;    deactivate View" style="text;whiteSpace=pre;html=1;fontSize=12;fontFamily=Courier New;fillColor=#F8FAFC;strokeColor=#CBD5E1;rounded=1;spacing=15;">
          <mxGeometry x="40" y="40" width="760" height="680" as_="geometry"/>
        </mxCell>
        <UserObject id="mermaid_data_obj" label="" mermaidData="{&quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Pengguna as Pengguna\n    participant View as registerForm:RegisterView\n    participant Ctrl as ctrlUsers:UsersController\n    participant DB as db:DataBase\n\n    %% Alur Utama (Navigasi)\n    Pengguna-&gt;&gt;View: directRegister()\n    activate View\n    View--&gt;&gt;Pengguna: displayRegisterForm()\n    deactivate View\n\n    %% Alur Pengisian &amp; Submit\n    Pengguna-&gt;&gt;View: submitData(email, password, confirmPassword)\n    activate View\n    View-&gt;&gt;Ctrl: register(email, password, confirmPassword)\n    activate Ctrl\n\n    %% Validasi di Controller\n    Ctrl-&gt;&gt;Ctrl: validateFormatData()\n\n    %% Percabangan (Alt Fragment)\n    alt Data Valid (Skenario Utama)\n        Ctrl-&gt;&gt;DB: storeUser(email, hashPassword, role=\&quot;user\&quot;, status=true)\n        activate DB\n        DB--&gt;&gt;Ctrl: returnSuccess\n        deactivate DB\n        Ctrl--&gt;&gt;View: registerSuccess(message)\n        View--&gt;&gt;Pengguna: directLoginPage()\n    else Format Email Salah / Kolom Kosong\n        Ctrl--&gt;&gt;View: showError(\&quot;Format email tidak valid / kolom kosong\&quot;)\n        View--&gt;&gt;Pengguna: displayErrorMessage()\n    else Password dan Confirm Password Tidak Cocok\n        Ctrl--&gt;&gt;View: showError(\&quot;Confirm password tidak cocok\&quot;)\n        View--&gt;&gt;Pengguna: displayMismatchMessage()\n    end\n    deactivate Ctrl\n    deactivate View&quot;, &quot;config&quot;: null}">
          <mxCell id="mermaid_cell" parent="1" vertex="1" connectable="0" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;"/>
        </UserObject>
      </root>
    </mxGraphModel>
